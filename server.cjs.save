// ==================================================
// ADD RESULT
// ==================================================

app.post(
  "/results",
  (req, res) => {
    const {
      student_id,
      student_name,
      subject,
      marks,
      total,
    } = req.body;

    const numericMarks =
      Number(marks);

    const numericTotal =
      Number(total) || 100;

    if (
      !student_name ||
      !subject ||
      isNaN(numericMarks)
    ) {
      return res.status(400).json({
        message:
          "Student, subject and marks are required.",
      });
    }

    if (
      numericMarks < 0 ||
      numericMarks >
        numericTotal
    ) {
      return res.status(400).json({
        message:
          "Invalid marks.",
      });
    }

    const sql = `
      INSERT INTO results
      (
        student_id,
        student_name,
        subject,
        marks,
        total
      )
      VALUES (?, ?, ?, ?, ?)
    `;

    db.query(
      sql,
      [
        student_id ||
          null,
        student_name,
        subject,
        numericMarks,
        numericTotal,
      ],
      (err, result) => {
        if (err) {
          console.error(
            "Add result error:",
            err
          );

          return res.status(500).json({
            message:
              "Failed to add result.",
          });
        }

        return res.json({
          success: true,

          message:
            "Result added successfully.",

          id:
            result.insertId,
        });
      }
    );
  }
);

