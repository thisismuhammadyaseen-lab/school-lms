// ATTENDANCE
// ==================================================

// GET ALL ATTENDANCE

app.get(
  "/attendance",
  (req, res) => {
    const sql = `
      SELECT
        a.id,
        a.student_id,
        s.name AS student_name,
        s.class_name,
        s.roll_number,
        s.student_code,
        a.attendance_date,
        a.status,
        a.created_at

      FROM attendance a

      LEFT JOIN students s
        ON a.student_id = s.id

      ORDER BY
        a.attendance_date DESC,
        a.id DESC
    `;

    db.query(
      sql,
      (err, results) => {
        if (err) {
          console.error(
            "Attendance error:",
            err
          );

          return res.status(500).json({
            message:
              "Failed to load attendance.",
          });
        }

        return res.json(
          results
        );
      }
    );
  }
);

// GET ATTENDANCE FOR ONE STUDENT

app.get(
  "/attendance/student/:studentId",
  (req, res) => {
    const studentId =
      req.params.studentId;

    const sql = `
      SELECT
        a.id,
        a.student_id,
        s.name AS student_name,
        s.class_name,
        s.roll_number,
        s.student_code,
        a.attendance_date,
        a.status,
        a.created_at

      FROM attendance a

      LEFT JOIN students s
        ON a.student_id = s.id

      WHERE a.student_id = ?

      ORDER BY
        a.attendance_date DESC,
        a.id DESC
    `;

    db.query(
      sql,
      [studentId],
      (err, results) => {
        if (err) {
          console.error(
            "Student attendance error:",
            err
          );

          return res.status(500).json({
            message:
              "Failed to load student attendance.",
          });
        }

        return res.json(
          results
        );
      }
    );
  }
);

// ADD ATTENDANCE

app.post(
  "/attendance",
  (req, res) => {
    const {
      student_id,
      attendance_date,
      status,
    } = req.body;

    if (
      !student_id ||
      !attendance_date ||
      !status
    ) {
      return res.status(400).json({
        message:
          "Student, date and attendance status are required.",
      });
    }

    const allowedStatus = [
      "Present",
      "Absent",
      "Late",
    ];

    if (
      !allowedStatus.includes(
        status
      )
    ) {
      return res.status(400).json({
        message:
          "Invalid attendance status.",
      });
    }

    const sql = `
      INSERT INTO attendance
      (
        student_id,
        attendance_date,
        status
      )
      VALUES (?, ?, ?)
    `;

    db.query(
      sql,
      [
        student_id,
        attendance_date,
        status,
      ],
      (err, result) => {
        if (err) {
          console.error(
            "Add attendance error:",
            err
          );

          if (
            err.code ===
            "ER_DUP_ENTRY"
          ) {
            return res.status(400).json({
              message:
                "Attendance already exists for this student on this date.",
            });
          }

          return res.status(500).json({
            message:
              "Failed to add attendance.",
          });
        }

        return res.json({
          success: true,

          message:
            "Attendance added successfully.",

          id:
            result.insertId,
        });
      }
    );
  }
);

// UPDATE ATTENDANCE

app.put(
  "/attendance/:id",
  (req, res) => {
    const id =
      req.params.id;

    const {
      student_id,
      attendance_date,
      status,
    } = req.body;

    if (
      !student_id ||
      !attendance_date ||
      !status
    ) {
      return res.status(400).json({
        message:
          "Student, date and attendance status are required.",
      });
    }

    const allowedStatus = [
      "Present",
      "Absent",
      "Late",
    ];

    if (
      !allowedStatus.includes(
        status
      )
    ) {
      return res.status(400).json({
        message:
          "Invalid attendance status.",
      });
    }

    const sql = `
      UPDATE attendance
      SET
        student_id = ?,
        attendance_date = ?,
        status = ?
      WHERE id = ?
    `;

    db.query(
      sql,
      [
        student_id,
        attendance_date,
        status,
        id,
      ],
      (err) => {
        if (err) {
          console.error(
            "Update attendance error:",
            err
          );

          if (
            err.code ===
            "ER_DUP_ENTRY"
          ) {
            return res.status(400).json({
              message:
                "Attendance already exists for this student on this date.",
            });
          }

          return res.status(500).json({
            message:
              "Failed to update attendance.",
          });
        }

        return res.json({
          success: true,

          message:
            "Attendance updated successfully.",
        });
      }
    );
  }
);

// DELETE ATTENDANCE

app.delete(
  "/attendance/:id",
  (req, res) => {
    const id =
      req.params.id;

    const sql = `
      DELETE FROM attendance
      WHERE id = ?
    `;

    db.query(
      sql,
      [id],
      (err) => {
        if (err) {
          console.error(
            "Delete attendance error:",
            err
          );

          return res.status(500).json({
            message:
              "Failed to delete attendance.",
          });
        }

        return res.json({
          success: true,

          message:
            "Attendance deleted successfully.",
        });
      }
    );
  }
);

