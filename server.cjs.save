// ==================================================
// ADMIN ADD ASSIGNMENT
// FILE IS OPTIONAL
// ==================================================

app.post(
  (req, res) => {
    const {
      title,
      subject,
      due_date,
      description,
    } = req.body;

    if (
      !title ||
      !title.trim()
    ) {
      return res.status(400).json({
        message:
          "Assignment title is required.",
      });
    }

    if (
      !subject ||
      !subject.trim()
    ) {
      return res.status(400).json({
        message:
          "Subject is required.",
      });
    }

    const sql = `
      INSERT INTO assignments
      (
     student_name,
      subject,
       file_name,
      file_path, 
        due_date,
        description
      )
      VALUES (?, ?, ?, ?, ?, ?)
    `;

    db.query(
      sql,
      [
        "All Students",

        subject.trim(),

        req.file.filename,

        req.file.path,

        due_date || null,

        description || null,
      ],
      (err, result) => {
        if (err) {
          console.error(
            "Admin assignment error:",
            err
          );

          return res.status(500).json({
            message:
              "Assignment add failed.",
            error:
              err.message,
          });
        }

        return res.json({
          success: true,

          message:
            "Assignment added successfully.",

          id:
            result.insertId,
        });
      }
    );
  }
);

// ==================================================
// DELETE ASSIGNMENT
// ==================================================

app.delete(
  "/assignments/:id",
  (req, res) => {
    const id =
      req.params.id;

    const getSql = `
      SELECT filename
      FROM assignments
      WHERE id = ?
    `;

    db.query(
      getSql,
      [id],
      (err, results) => {
        if (err) {
          console.error(
            err
          );

          return res.status(500).json({
            message:
              "Failed to find assignment.",
          });
        }

        if (
          results.length > 0 &&
          results[0].filename
        ) {
          const filePath =
            path.join(
              uploadFolder,
              results[0].filename
            );

          if (
            fs.existsSync(
              filePath
            )
          ) {
            try {
              fs.unlinkSync(
                filePath
              );
            } catch (fileError) {
              console.error(
                "File delete error:",
                fileError
              );
            }
          }
        }

        const deleteSql = `
          DELETE FROM assignments
          WHERE id = ?
        `;

        db.query(
          deleteSql,
          [id],
          (deleteErr) => {
            if (deleteErr) {
              console.error(
                deleteErr
              );

              return res.status(500).json({
                message:
                  "Failed to delete assignment.",
              });
            }

            return res.json({
              success: true,

              message:
                "Assignment deleted successfully.",
            });
          }
        );
      }
    );
  }
);

