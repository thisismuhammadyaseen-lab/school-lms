/* =========================================================
   IQRA MODEL HIGH SCHOOL - PROFESSIONAL LMS
   App.css
   ========================================================= */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --primary: #0f4c81;
  --primary-dark: #0a355c;
  --primary-light: #eaf4ff;
  --secondary: #1677c8;
  --accent: #f5b942;

  --success: #16a34a;
  --danger: #dc2626;
  --warning: #d97706;

  --text: #172033;
  --text-light: #64748b;
  --white: #ffffff;

  --bg: #f4f7fb;
  --border: #e2e8f0;

  --shadow-sm: 0 4px 12px rgba(15, 76, 129, 0.07);
  --shadow: 0 10px 30px rgba(15, 76, 129, 0.10);
  --shadow-lg: 0 18px 50px rgba(15, 76, 129, 0.14);

  --radius: 16px;
  --radius-lg: 22px;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family:
    Inter,
    "Segoe UI",
    Arial,
    sans-serif;

  background: var(--bg);
  color: var(--text);
  line-height: 1.6;
}

button,
input,
select,
textarea {
  font-family: inherit;
}

button {
  cursor: pointer;
}

a {
  text-decoration: none;
  color: inherit;
}

.app {
  min-height: 100vh;
  background:
    linear-gradient(
      180deg,
      #f8fbff 0%,
      #f4f7fb 45%,
      #eef3f8 100%
    );
}


/* =========================================================
   TOP HEADER
   ========================================================= */

.top-header {
  background: #ffffff;
  border-bottom: 1px solid var(--border);
  box-shadow: 0 3px 18px rgba(15, 76, 129, 0.06);
  position: sticky;
  top: 0;
  z-index: 1000;
}

.header-inner {
  max-width: 1400px;
  margin: auto;
  min-height: 82px;
  padding: 12px 30px;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
}

.school-brand {
  display: flex;
  align-items: center;
  gap: 14px;
}

.school-logo {
  width: 56px;
  height: 56px;
  border-radius: 14px;
  object-fit: cover;

  background: var(--primary-light);
  border: 2px solid #d8eaff;
  padding: 4px;
}

.school-brand h1 {
  color: var(--primary-dark);
  font-size: 21px;
  font-weight: 800;
  line-height: 1.2;
}

.school-brand p {
  color: var(--text-light);
  font-size: 12px;
  margin-top: 3px;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.login-button,
.admin-button,
.logout-button {
  border: none;
  padding: 11px 17px;
  border-radius: 10px;
  font-weight: 700;
  font-size: 13px;
  transition: 0.25s ease;
}

.login-button {
  background: var(--primary-light);
  color: var(--primary);
}

.login-button:hover {
  background: #dceeff;
  transform: translateY(-1px);
}

.admin-button {
  background: var(--primary);
  color: white;
}

.admin-button:hover {
  background: var(--primary-dark);
  transform: translateY(-1px);
}

.logout-button {
  background: #fff1f2;
  color: #be123c;
}

.logout-button:hover {
  background: #ffe4e6;
}

.student-header {
  display: flex;
  align-items: center;
  gap: 10px;
}

.mini-avatar {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: linear-gradient(
    135deg,
    var(--primary),
    var(--secondary)
  );
  color: white;

  display: flex;
  align-items: center;
  justify-content: center;

  font-weight: 800;
}


/* =========================================================
   NAVIGATION
   ========================================================= */

.main-nav {
  background: var(--primary-dark);
  color: white;
}

.nav-inner {
  max-width: 1400px;
  margin: auto;
  padding: 0 30px;

  display: flex;
  align-items: center;
  gap: 5px;

  overflow-x: auto;
}

.nav-link {
  border: none;
  background: transparent;
  color: rgba(255,255,255,0.82);

  padding: 14px 17px;
  font-size: 13px;
  font-weight: 700;

  white-space: nowrap;
  border-bottom: 3px solid transparent;

  transition: 0.25s ease;
}

.nav-link:hover,
.nav-link.active {
  color: white;
  background: rgba(255,255,255,0.08);
  border-bottom-color: var(--accent);
}


/* =========================================================
   MAIN CONTENT
   ========================================================= */

.main-content {
  max-width: 1400px;
  margin: auto;
  padding: 28px 30px 50px;
}


/* =========================================================
   SCHOOL HERO
   ========================================================= */

.school-hero {
  position: relative;
  min-height: 430px;
  border-radius: 26px;
  overflow: hidden;
  margin-bottom: 35px;

  background: var(--primary-dark);
  box-shadow: var(--shadow-lg);
}

.school-hero-image {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;
}

.school-hero-overlay {
  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      90deg,
      rgba(5, 27, 49, 0.94) 0%,
      rgba(10, 53, 92, 0.82) 45%,
      rgba(15, 76, 129, 0.40) 100%
    );
}

.school-hero-content {
  position: relative;
  z-index: 2;

  max-width: 760px;
  min-height: 430px;

  padding: 65px 60px;

  display: flex;
  flex-direction: column;
  justify-content: center;

  color: white;
}

.school-badge,
.welcome-badge {
  width: fit-content;

  background: rgba(255,255,255,0.13);
  border: 1px solid rgba(255,255,255,0.25);

  color: white;
  padding: 8px 14px;
  border-radius: 30px;

  font-size: 12px;
  font-weight: 700;

  backdrop-filter: blur(8px);
  margin-bottom: 18px;
}

.school-hero h1 {
  font-size: clamp(34px, 5vw, 58px);
  line-height: 1.08;
  font-weight: 900;
  letter-spacing: -1.5px;
  margin-bottom: 18px;
}

.school-hero p {
  color: rgba(255,255,255,0.88);
  font-size: 16px;
  max-width: 650px;
}

.hero-main-button,
.hero-outline-button {
  border: none;
  padding: 13px 20px;
  border-radius: 11px;
  font-weight: 800;
  transition: 0.25s ease;
}

.hero-main-button {
  background: white;
  color: var(--primary-dark);
}

.hero-main-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(0,0,0,0.18);
}

.hero-outline-button {
  color: white;
  background: rgba(255,255,255,0.10);
  border: 1px solid rgba(255,255,255,0.35);
}

.hero-outline-button:hover {
  background: rgba(255,255,255,0.18);
}

.hero-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 26px;
}


/* =========================================================
   OLD HERO SUPPORT
   ========================================================= */

.hero-section {
  background: white;
  border-radius: var(--radius-lg);
  padding: 40px;
  box-shadow: var(--shadow);
}

.hero-content {
  max-width: 850px;
}

.hero-section h1 {
  color: var(--primary-dark);
  font-size: 42px;
  line-height: 1.15;
  margin-bottom: 15px;
}

.hero-decoration,
.hero-circle {
  display: none;
}


/* =========================================================
   BUTTONS
   ========================================================= */

.primary-button,
.secondary-button,
.outline-button {
  border: none;
  padding: 12px 19px;
  border-radius: 10px;
  font-size: 13px;
  font-weight: 800;
  transition: 0.25s ease;
}

.primary-button {
  background: var(--primary);
  color: white;
}

.primary-button:hover {
  background: var(--primary-dark);
  transform: translateY(-2px);
}

.secondary-button {
  background: #eaf4ff;
  color: var(--primary);
}

.secondary-button:hover {
  background: #dceeff;
}

.outline-button {
  background: white;
  color: var(--primary);
  border: 1px solid #bfd5e9;
}

.outline-button:hover {
  border-color: var(--primary);
  background: var(--primary-light);
}


/* =========================================================
   STATS
   ========================================================= */

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin-bottom: 34px;
}

.stat-card {
  position: relative;

  background: white;
  border: 1px solid var(--border);

  border-radius: var(--radius);
  padding: 22px;

  display: flex;
  align-items: center;
  gap: 15px;

  box-shadow: var(--shadow-sm);

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    border-color 0.25s ease;
}

.stat-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 20px;
  bottom: 20px;

  width: 4px;
  border-radius: 0 5px 5px 0;
  background: var(--primary);
}

.stat-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow);
  border-color: #cbddec;
}

.stat-icon {
  width: 52px;
  height: 52px;

  flex-shrink: 0;

  border-radius: 14px;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 22px;
  background: var(--primary-light);
  color: var(--primary);
}

.stat-icon.blue {
  background: #eaf4ff;
  color: #1677c8;
}

.stat-icon.green {
  background: #ecfdf3;
  color: #15803d;
}

.stat-icon.orange {
  background: #fff7ed;
  color: #c2410c;
}

.stat-icon.purple {
  background: #f5f3ff;
  color: #6d28d9;
}

.stat-card h3 {
  font-size: 27px;
  line-height: 1;
  color: var(--primary-dark);
  margin-bottom: 5px;
}

.stat-card p {
  color: var(--text-light);
  font-size: 12px;
  font-weight: 700;
}


/* =========================================================
   SECTIONS
   ========================================================= */

.dashboard-section {
  margin-top: 34px;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;

  margin-bottom: 17px;
}

.section-heading h2 {
  color: var(--primary-dark);
  font-size: 21px;
  font-weight: 850;
}

.section-heading p {
  color: var(--text-light);
  font-size: 13px;
}


/* =========================================================
   QUICK INFO BOXES
   ========================================================= */

.quick-info-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.quick-info-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: var(--radius);

  padding: 22px;

  box-shadow: var(--shadow-sm);

  transition: 0.25s ease;
}

.quick-info-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow);
}

.quick-info-card h3 {
  color: var(--primary-dark);
  font-size: 16px;
  margin-bottom: 7px;
}

.quick-info-card p {
  color: var(--text-light);
  font-size: 13px;
}

.online-text {
  color: var(--success) !important;
  font-weight: 800;
}


/* =========================================================
   ANNOUNCEMENTS
   ========================================================= */

.announcement-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.announcement-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: var(--radius);

  padding: 22px;

  box-shadow: var(--shadow-sm);
  transition: 0.25s ease;
}

.announcement-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow);
}

.announcement-icon {
  width: 44px;
  height: 44px;

  border-radius: 12px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: var(--primary-light);
  color: var(--primary);

  margin-bottom: 13px;
}

.announcement-card h3 {
  font-size: 16px;
  color: var(--primary-dark);
  margin-bottom: 7px;
}

.announcement-card p {
  color: var(--text-light);
  font-size: 13px;
}


/* =========================================================
   PRINCIPAL SECTION - PROFESSIONAL
   ========================================================= */

.principal-section {
  position: relative;

  display: grid;
  grid-template-columns: 280px 1fr;
  align-items: center;

  gap: 35px;

  margin-top: 38px;

  padding: 34px;

  background:
    linear-gradient(
      135deg,
      #ffffff 0%,
      #f5faff 100%
    );

  border: 1px solid #dce8f3;
  border-radius: 22px;

  box-shadow: var(--shadow);

  overflow: hidden;
}

.principal-section::after {
  content: "";
  position: absolute;

  width: 240px;
  height: 240px;

  border-radius: 50%;

  background: rgba(22,119,200,0.05);

  right: -70px;
  bottom: -100px;
}

.principal-image-box {
  position: relative;
  z-index: 2;

  display: flex;
  justify-content: center;
}

.principal-image {
  width: 220px;
  height: 220px;

  object-fit: cover;

  border-radius: 22px;

  border: 6px solid white;

  box-shadow:
    0 14px 35px rgba(15,76,129,0.18);

  background: #eaf4ff;
}

.principal-sign {
  position: relative;
  z-index: 2;
}

.principal-sign span {
  display: inline-block;

  color: var(--secondary);
  font-size: 12px;
  font-weight: 800;

  background: #eaf4ff;
  padding: 6px 11px;
  border-radius: 20px;

  margin-bottom: 10px;
}

.principal-sign h2 {
  color: var(--primary-dark);
  font-size: 29px;
  font-weight: 900;
  margin-bottom: 8px;
}

.principal-sign p {
  color: var(--text-light);
  max-width: 700px;
  font-size: 14px;
}


/* =========================================================
   PAGE SECTION
   ========================================================= */

.page-section {
  padding: 5px 0;
}

.page-title {
  color: var(--primary-dark);
  font-size: 30px;
  font-weight: 900;
  margin-bottom: 22px;
}


/* =========================================================
   CONTENT CARDS
   ========================================================= */

.content-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: var(--radius);

  padding: 24px;

  box-shadow: var(--shadow-sm);
}

.card-heading {
  display: flex;
  align-items: center;
  gap: 10px;

  margin-bottom: 18px;
}

.card-heading h2,
.card-heading h3 {
  color: var(--primary-dark);
  font-size: 18px;
}

.heading-icon {
  width: 40px;
  height: 40px;

  border-radius: 11px;

  background: var(--primary-light);
  color: var(--primary);

  display: flex;
  align-items: center;
  justify-content: center;
}


/* =========================================================
   ASSIGNMENTS
   ========================================================= */

.assignment-layout {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 20px;
}

.assignment-list {
  display: flex;
  flex-direction: column;
  gap: 13px;
}

.assignment-item {
  background: white;
  border: 1px solid var(--border);
  border-radius: 15px;

  padding: 18px;

  display: flex;
  align-items: center;
  gap: 14px;

  box-shadow: var(--shadow-sm);
  transition: 0.25s ease;
}

.assignment-item:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow);
}

.assignment-icon {
  width: 48px;
  height: 48px;

  flex-shrink: 0;

  border-radius: 13px;

  background: #eaf4ff;
  color: var(--primary);

  display: flex;
  align-items: center;
  justify-content: center;
}

.assignment-info {
  flex: 1;
}

.assignment-info h3 {
  color: var(--primary-dark);
  font-size: 15px;
}

.assignment-info p {
  color: var(--text-light);
  font-size: 12px;
}

.assignment-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;

  margin-top: 6px;

  color: var(--text-light);
  font-size: 11px;
}

.download-button {
  border: none;
  background: var(--primary);
  color: white;

  padding: 9px 12px;
  border-radius: 9px;

  font-size: 12px;
  font-weight: 800;

  transition: 0.25s ease;
}

.download-button:hover {
  background: var(--primary-dark);
}


/* =========================================================
   FORMS
   ========================================================= */

.assignment-form {
  background: white;
  border: 1px solid var(--border);
  border-radius: var(--radius);

  padding: 24px;

  box-shadow: var(--shadow-sm);
}

.form-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 15px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 7px;
  margin-bottom: 15px;
}

.form-group label {
  color: var(--primary-dark);
  font-size: 12px;
  font-weight: 800;
}

.form-group input,
.form-group select,
.form-group textarea {
  width: 100%;

  border: 1px solid #d5e0eb;
  background: #fbfdff;

  padding: 11px 13px;

  border-radius: 10px;
  outline: none;

  color: var(--text);

  transition: 0.2s ease;
}

.form-group textarea {
  min-height: 110px;
  resize: vertical;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  border-color: var(--secondary);
  box-shadow: 0 0 0 3px rgba(22,119,200,0.10);
  background: white;
}

.success-message {
  padding: 11px 14px;
  border-radius: 10px;

  background: #ecfdf3;
  border: 1px solid #bbf7d0;

  color: #15803d;

  font-size: 13px;
  font-weight: 700;

  margin-bottom: 15px;
}


/* =========================================================
   EMPTY / LOGIN
   ========================================================= */

.empty-state,
.login-required {
  background: white;
  border: 1px dashed #cbd5e1;
  border-radius: var(--radius);

  padding: 45px 25px;

  text-align: center;
  color: var(--text-light);
}

.empty-state h3,
.login-required h3 {
  color: var(--primary-dark);
  margin-bottom: 7px;
}


/* =========================================================
   TABLE
   ========================================================= */

.table-wrapper {
  width: 100%;
  overflow-x: auto;

  background: white;
  border: 1px solid var(--border);
  border-radius: var(--radius);

  box-shadow: var(--shadow-sm);
}

.results-table {
  width: 100%;
  border-collapse: collapse;
  min-width: 700px;
}

.results-table th {
  background: #f3f7fb;
  color: var(--primary-dark);

  text-align: left;

  padding: 14px 16px;

  font-size: 12px;
  font-weight: 850;

  border-bottom: 1px solid var(--border);
}

.results-table td {
  padding: 14px 16px;

  color: #475569;
  font-size: 13px;

  border-bottom: 1px solid #edf1f5;
}

.results-table tr:last-child td {
  border-bottom: none;
}

.results-table tbody tr:hover {
  background: #f8fbff;
}

.grade-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 5px 10px;
  border-radius: 20px;

  background: #eaf4ff;
  color: var(--primary);

  font-size: 11px;
  font-weight: 900;
}


/* =========================================================
   PROFILE
   ========================================================= */

.profile-grid {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 20px;
}

.profile-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: var(--radius);

  padding: 28px;

  box-shadow: var(--shadow-sm);
}

.profile-card:first-child {
  text-align: center;
}

.profile-avatar {
  width: 110px;
  height: 110px;

  margin: 0 auto 15px;

  border-radius: 50%;

  background:
    linear-gradient(
      135deg,
      var(--primary),
      var(--secondary)
    );

  color: white;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 34px;
  font-weight: 900;

  border: 5px solid white;

  box-shadow: 0 10px 25px rgba(15,76,129,0.18);
}

.profile-card h2 {
  color: var(--primary-dark);
  font-size: 21px;
}

.profile-card > p {
  color: var(--text-light);
  font-size: 13px;
}

.profile-status {
  display: inline-block;

  margin-top: 12px;

  padding: 6px 12px;

  border-radius: 20px;

  background: #ecfdf3;
  color: #15803d;

  font-size: 11px;
  font-weight: 900;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 13px;
}

.info-grid > div {
  padding: 15px;

  background: #f8fafc;

  border: 1px solid #e7edf3;

  border-radius: 12px;
}

.info-grid span {
  display: block;

  color: var(--text-light);

  font-size: 11px;
  font-weight: 700;

  margin-bottom: 4px;
}

.info-grid strong {
  color: var(--primary-dark);
  font-size: 14px;
}


/* =========================================================
   FOOTER
   ========================================================= */

.footer {
  margin-top: 55px;

  background: #082d4f;
  color: white;
}

.footer-inner {
  max-width: 1400px;
  margin: auto;

  padding: 35px 30px;

  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 30px;
}

.footer h3 {
  font-size: 18px;
  margin-bottom: 7px;
}

.footer p {
  color: rgba(255,255,255,0.70);
  font-size: 12px;
}

.footer-links {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
}

.footer-links a {
  color: rgba(255,255,255,0.78);
  font-size: 12px;
}

.footer-links a:hover {
  color: white;
}

.footer-bottom {
  border-top: 1px solid rgba(255,255,255,0.10);

  max-width: 1400px;
  margin: auto;

  padding: 15px 30px;

  color: rgba(255,255,255,0.55);

  font-size: 11px;
}


/* =========================================================
   GENERAL TEXT
   ========================================================= */

.text-muted {
  color: var(--text-light);
}

.text-success {
  color: var(--success);
}

.text-danger {
  color: var(--danger);
}

.text-warning {
  color: var(--warning);
}


/* =========================================================
   RESPONSIVE - TABLET
   ========================================================= */

@media (max-width: 1100px) {

  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .quick-info-grid,
  .announcement-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .assignment-layout {
    grid-template-columns: 1fr;
  }

  .principal-section {
    grid-template-columns: 220px 1fr;
  }

}


/* =========================================================
   RESPONSIVE - MOBILE
   ========================================================= */

@media (max-width: 760px) {

  .header-inner {
    padding: 12px 16px;
    min-height: 70px;
  }

  .school-brand h1 {
    font-size: 16px;
  }

  .school-brand p {
    display: none;
  }

  .school-logo {
    width: 45px;
    height: 45px;
  }

  .header-actions {
    gap: 6px;
  }

  .login-button,
  .admin-button,
  .logout-button {
    padding: 9px 11px;
    font-size: 11px;
  }

  .nav-inner {
    padding: 0 12px;
  }

  .nav-link {
    padding: 12px 11px;
    font-size: 11px;
  }

  .main-content {
    padding: 18px 15px 35px;
  }

  .school-hero {
    min-height: 390px;
    border-radius: 18px;
  }

  .school-hero-content {
    min-height: 390px;
    padding: 40px 25px;
  }

  .school-hero h1 {
    font-size: 34px;
  }

  .school-hero p {
    font-size: 14px;
  }

  .stats-grid {
    grid-template-columns: 1fr 1fr;
    gap: 11px;
  }

  .stat-card {
    padding: 15px;
  }

  .stat-icon {
    width: 43px;
    height: 43px;
    font-size: 18px;
  }

  .stat-card h3 {
    font-size: 22px;
  }

  .quick-info-grid,
  .announcement-grid {
    grid-template-columns: 1fr;
  }

  .principal-section {
    grid-template-columns: 1fr;
    text-align: center;
    padding: 25px 18px;
  }

  .principal-image {
    width: 180px;
    height: 180px;
  }

  .principal-sign h2 {
    font-size: 23px;
  }

  .profile-grid {
    grid-template-columns: 1fr;
  }

  .form-row {
    grid-template-columns: 1fr;
  }

  .info-grid {
    grid-template-columns: 1fr;
  }

  .footer-inner {
    flex-direction: column;
    padding: 30px 20px;
  }

}


/* =========================================================
   SMALL MOBILE
   ========================================================= */

@media (max-width: 450px) {

  .student-header span {
    display: none;
  }

  .stats-grid {
    grid-template-columns: 1fr;
  }

  .school-hero h1 {
    font-size: 29px;
  }

  .hero-buttons {
    flex-direction: column;
  }

  .hero-main-button,
  .hero-outline-button {
    width: 100%;
  }

  .page-title {
    font-size: 25px;
  }

  .content-card,
  .assignment-form,
  .profile-card {
    padding: 18px;
  }

}


/* =========================================================
   SCROLLBAR
   ========================================================= */

::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: #eef2f7;
}

::-webkit-scrollbar-thumb {
  background: #a9bfd4;
  border-radius: 20px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--primary);
}


/* =========================================================
   SELECTION
   ========================================================= */

::selection {
  background: #cfe7fb;
  color: var(--primary-dark);
}/* =========================================================
   IQRA MODEL HIGH SCHOOL - PROFESSIONAL LMS
   App.css
   ========================================================= */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --primary: #0f4c81;
  --primary-dark: #0a355c;
  --primary-light: #eaf4ff;
  --secondary: #1677c8;
  --accent: #f5b942;

  --success: #16a34a;
  --danger: #dc2626;
  --warning: #d97706;

  --text: #172033;
  --text-light: #64748b;
  --white: #ffffff;

  --bg: #f4f7fb;
  --border: #e2e8f0;

  --shadow-sm: 0 4px 12px rgba(15, 76, 129, 0.07);
  --shadow: 0 10px 30px rgba(15, 76, 129, 0.10);
  --shadow-lg: 0 18px 50px rgba(15, 76, 129, 0.14);

  --radius: 16px;
  --radius-lg: 22px;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family:
    Inter,
    "Segoe UI",
    Arial,
    sans-serif;

  background: var(--bg);
  color: var(--text);
  line-height: 1.6;
}

button,
input,
select,
textarea {
  font-family: inherit;
}

button {
  cursor: pointer;
}

a {
  text-decoration: none;
  color: inherit;
}

.app {
  min-height: 100vh;
  background:
    linear-gradient(
      180deg,
      #f8fbff 0%,
      #f4f7fb 45%,
      #eef3f8 100%
    );
}


/* =========================================================
   TOP HEADER
   ========================================================= */

.top-header {
  background: #ffffff;
  border-bottom: 1px solid var(--border);
  box-shadow: 0 3px 18px rgba(15, 76, 129, 0.06);
  position: sticky;
  top: 0;
  z-index: 1000;
}

.header-inner {
  max-width: 1400px;
  margin: auto;
  min-height: 82px;
  padding: 12px 30px;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
}

.school-brand {
  display: flex;
  align-items: center;
  gap: 14px;
}

.school-logo {
  width: 56px;
  height: 56px;
  border-radius: 14px;
  object-fit: cover;

  background: var(--primary-light);
  border: 2px solid #d8eaff;
  padding: 4px;
}

.school-brand h1 {
  color: var(--primary-dark);
  font-size: 21px;
  font-weight: 800;
  line-height: 1.2;
}

.school-brand p {
  color: var(--text-light);
  font-size: 12px;
  margin-top: 3px;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.login-button,
.admin-button,
.logout-button {
  border: none;
  padding: 11px 17px;
  border-radius: 10px;
  font-weight: 700;
  font-size: 13px;
  transition: 0.25s ease;
}

.login-button {
  background: var(--primary-light);
  color: var(--primary);
}

.login-button:hover {
  background: #dceeff;
  transform: translateY(-1px);
}

.admin-button {
  background: var(--primary);
  color: white;
}

.admin-button:hover {
  background: var(--primary-dark);
  transform: translateY(-1px);
}

.logout-button {
  background: #fff1f2;
  color: #be123c;
}

.logout-button:hover {
  background: #ffe4e6;
}

.student-header {
  display: flex;
  align-items: center;
  gap: 10px;
}

.mini-avatar {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: linear-gradient(
    135deg,
    var(--primary),
    var(--secondary)
  );
  color: white;

  display: flex;
  align-items: center;
  justify-content: center;

  font-weight: 800;
}


/* =========================================================
   NAVIGATION
   ========================================================= */

.main-nav {
  background: var(--primary-dark);
  color: white;
}

.nav-inner {
  max-width: 1400px;
  margin: auto;
  padding: 0 30px;

  display: flex;
  align-items: center;
  gap: 5px;

  overflow-x: auto;
}

.nav-link {
  border: none;
  background: transparent;
  color: rgba(255,255,255,0.82);

  padding: 14px 17px;
  font-size: 13px;
  font-weight: 700;

  white-space: nowrap;
  border-bottom: 3px solid transparent;

  transition: 0.25s ease;
}

.nav-link:hover,
.nav-link.active {
  color: white;
  background: rgba(255,255,255,0.08);
  border-bottom-color: var(--accent);
}


/* =========================================================
   MAIN CONTENT
   ========================================================= */

.main-content {
  max-width: 1400px;
  margin: auto;
  padding: 28px 30px 50px;
}


/* =========================================================
   SCHOOL HERO
   ========================================================= */

.school-hero {
  position: relative;
  min-height: 430px;
  border-radius: 26px;
  overflow: hidden;
  margin-bottom: 35px;

  background: var(--primary-dark);
  box-shadow: var(--shadow-lg);
}

.school-hero-image {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;
}

.school-hero-overlay {
  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      90deg,
      rgba(5, 27, 49, 0.94) 0%,
      rgba(10, 53, 92, 0.82) 45%,
      rgba(15, 76, 129, 0.40) 100%
    );
}

.school-hero-content {
  position: relative;
  z-index: 2;

  max-width: 760px;
  min-height: 430px;

  padding: 65px 60px;

  display: flex;
  flex-direction: column;
  justify-content: center;

  color: white;
}

.school-badge,
.welcome-badge {
  width: fit-content;

  background: rgba(255,255,255,0.13);
  border: 1px solid rgba(255,255,255,0.25);

  color: white;
  padding: 8px 14px;
  border-radius: 30px;

  font-size: 12px;
  font-weight: 700;

  backdrop-filter: blur(8px);
  margin-bottom: 18px;
}

.school-hero h1 {
  font-size: clamp(34px, 5vw, 58px);
  line-height: 1.08;
  font-weight: 900;
  letter-spacing: -1.5px;
  margin-bottom: 18px;
}

.school-hero p {
  color: rgba(255,255,255,0.88);
  font-size: 16px;
  max-width: 650px;
}

.hero-main-button,
.hero-outline-button {
  border: none;
  padding: 13px 20px;
  border-radius: 11px;
  font-weight: 800;
  transition: 0.25s ease;
}

.hero-main-button {
  background: white;
  color: var(--primary-dark);
}

.hero-main-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(0,0,0,0.18);
}

.hero-outline-button {
  color: white;
  background: rgba(255,255,255,0.10);
  border: 1px solid rgba(255,255,255,0.35);
}

.hero-outline-button:hover {
  background: rgba(255,255,255,0.18);
}

.hero-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 26px;
}


/* =========================================================
   OLD HERO SUPPORT
   ========================================================= */

.hero-section {
  background: white;
  border-radius: var(--radius-lg);
  padding: 40px;
  box-shadow: var(--shadow);
}

.hero-content {
  max-width: 850px;
}

.hero-section h1 {
  color: var(--primary-dark);
  font-size: 42px;
  line-height: 1.15;
  margin-bottom: 15px;
}

.hero-decoration,
.hero-circle {
  display: none;
}


/* =========================================================
   BUTTONS
   ========================================================= */

.primary-button,
.secondary-button,
.outline-button {
  border: none;
  padding: 12px 19px;
  border-radius: 10px;
  font-size: 13px;
  font-weight: 800;
  transition: 0.25s ease;
}

.primary-button {
  background: var(--primary);
  color: white;
}

.primary-button:hover {
  background: var(--primary-dark);
  transform: translateY(-2px);
}

.secondary-button {
  background: #eaf4ff;
  color: var(--primary);
}

.secondary-button:hover {
  background: #dceeff;
}

.outline-button {
  background: white;
  color: var(--primary);
  border: 1px solid #bfd5e9;
}

.outline-button:hover {
  border-color: var(--primary);
  background: var(--primary-light);
}


/* =========================================================
   STATS
   ========================================================= */

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin-bottom: 34px;
}

.stat-card {
  position: relative;

  background: white;
  border: 1px solid var(--border);

  border-radius: var(--radius);
  padding: 22px;

  display: flex;
  align-items: center;
  gap: 15px;

  box-shadow: var(--shadow-sm);

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    border-color 0.25s ease;
}

.stat-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 20px;
  bottom: 20px;

  width: 4px;
  border-radius: 0 5px 5px 0;
  background: var(--primary);
}

.stat-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow);
  border-color: #cbddec;
}

.stat-icon {
  width: 52px;
  height: 52px;

  flex-shrink: 0;

  border-radius: 14px;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 22px;
  background: var(--primary-light);
  color: var(--primary);
}

.stat-icon.blue {
  background: #eaf4ff;
  color: #1677c8;
}

.stat-icon.green {
  background: #ecfdf3;
  color: #15803d;
}

.stat-icon.orange {
  background: #fff7ed;
  color: #c2410c;
}

.stat-icon.purple {
  background: #f5f3ff;
  color: #6d28d9;
}

.stat-card h3 {
  font-size: 27px;
  line-height: 1;
  color: var(--primary-dark);
  margin-bottom: 5px;
}

.stat-card p {
  color: var(--text-light);
  font-size: 12px;
  font-weight: 700;
}


/* =========================================================
   SECTIONS
   ========================================================= */

.dashboard-section {
  margin-top: 34px;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;

  margin-bottom: 17px;
}

.section-heading h2 {
  color: var(--primary-dark);
  font-size: 21px;
  font-weight: 850;
}

.section-heading p {
  color: var(--text-light);
  font-size: 13px;
}


/* =========================================================
   QUICK INFO BOXES
   ========================================================= */

.quick-info-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.quick-info-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: var(--radius);

  padding: 22px;

  box-shadow: var(--shadow-sm);

  transition: 0.25s ease;
}

.quick-info-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow);
}

.quick-info-card h3 {
  color: var(--primary-dark);
  font-size: 16px;
  margin-bottom: 7px;
}

.quick-info-card p {
  color: var(--text-light);
  font-size: 13px;
}

.online-text {
  color: var(--success) !important;
  font-weight: 800;
}


/* =========================================================
   ANNOUNCEMENTS
   ========================================================= */

.announcement-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.announcement-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: var(--radius);

  padding: 22px;

  box-shadow: var(--shadow-sm);
  transition: 0.25s ease;
}

.announcement-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow);
}

.announcement-icon {
  width: 44px;
  height: 44px;

  border-radius: 12px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: var(--primary-light);
  color: var(--primary);

  margin-bottom: 13px;
}

.announcement-card h3 {
  font-size: 16px;
  color: var(--primary-dark);
  margin-bottom: 7px;
}

.announcement-card p {
  color: var(--text-light);
  font-size: 13px;
}


/* =========================================================
   PRINCIPAL SECTION - PROFESSIONAL
   ========================================================= */

.principal-section {
  position: relative;

  display: grid;
  grid-template-columns: 280px 1fr;
  align-items: center;

  gap: 35px;

  margin-top: 38px;

  padding: 34px;

  background:
    linear-gradient(
      135deg,
      #ffffff 0%,
      #f5faff 100%
    );

  border: 1px solid #dce8f3;
  border-radius: 22px;

  box-shadow: var(--shadow);

  overflow: hidden;
}

.principal-section::after {
  content: "";
  position: absolute;

  width: 240px;
  height: 240px;

  border-radius: 50%;

  background: rgba(22,119,200,0.05);

  right: -70px;
  bottom: -100px;
}

.principal-image-box {
  position: relative;
  z-index: 2;

  display: flex;
  justify-content: center;
}

.principal-image {
  width: 220px;
  height: 220px;

  object-fit: cover;

  border-radius: 22px;

  border: 6px solid white;

  box-shadow:
    0 14px 35px rgba(15,76,129,0.18);

  background: #eaf4ff;
}

.principal-sign {
  position: relative;
  z-index: 2;
}

.principal-sign span {
  display: inline-block;

  color: var(--secondary);
  font-size: 12px;
  font-weight: 800;

  background: #eaf4ff;
  padding: 6px 11px;
  border-radius: 20px;

  margin-bottom: 10px;
}

.principal-sign h2 {
  color: var(--primary-dark);
  font-size: 29px;
  font-weight: 900;
  margin-bottom: 8px;
}

.principal-sign p {
  color: var(--text-light);
  max-width: 700px;
  font-size: 14px;
}


/* =========================================================
   PAGE SECTION
   ========================================================= */

.page-section {
  padding: 5px 0;
}

.page-title {
  color: var(--primary-dark);
  font-size: 30px;
  font-weight: 900;
  margin-bottom: 22px;
}


/* =========================================================
   CONTENT CARDS
   ========================================================= */

.content-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: var(--radius);

  padding: 24px;

  box-shadow: var(--shadow-sm);
}

.card-heading {
  display: flex;
  align-items: center;
  gap: 10px;

  margin-bottom: 18px;
}

.card-heading h2,
.card-heading h3 {
  color: var(--primary-dark);
  font-size: 18px;
}

.heading-icon {
  width: 40px;
  height: 40px;

  border-radius: 11px;

  background: var(--primary-light);
  color: var(--primary);

  display: flex;
  align-items: center;
  justify-content: center;
}


/* =========================================================
   ASSIGNMENTS
   ========================================================= */

.assignment-layout {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 20px;
}

.assignment-list {
  display: flex;
  flex-direction: column;
  gap: 13px;
}

.assignment-item {
  background: white;
  border: 1px solid var(--border);
  border-radius: 15px;

  padding: 18px;

  display: flex;
  align-items: center;
  gap: 14px;

  box-shadow: var(--shadow-sm);
  transition: 0.25s ease;
}

.assignment-item:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow);
}

.assignment-icon {
  width: 48px;
  height: 48px;

  flex-shrink: 0;

  border-radius: 13px;

  background: #eaf4ff;
  color: var(--primary);

  display: flex;
  align-items: center;
  justify-content: center;
}

.assignment-info {
  flex: 1;
}

.assignment-info h3 {
  color: var(--primary-dark);
  font-size: 15px;
}

.assignment-info p {
  color: var(--text-light);
  font-size: 12px;
}

.assignment-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;

  margin-top: 6px;

  color: var(--text-light);
  font-size: 11px;
}

.download-button {
  border: none;
  background: var(--primary);
  color: white;

  padding: 9px 12px;
  border-radius: 9px;

  font-size: 12px;
  font-weight: 800;

  transition: 0.25s ease;
}

.download-button:hover {
  background: var(--primary-dark);
}


/* =========================================================
   FORMS
   ========================================================= */

.assignment-form {
  background: white;
  border: 1px solid var(--border);
  border-radius: var(--radius);

  padding: 24px;

  box-shadow: var(--shadow-sm);
}

.form-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 15px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 7px;
  margin-bottom: 15px;
}

.form-group label {
  color: var(--primary-dark);
  font-size: 12px;
  font-weight: 800;
}

.form-group input,
.form-group select,
.form-group textarea {
  width: 100%;

  border: 1px solid #d5e0eb;
  background: #fbfdff;

  padding: 11px 13px;

  border-radius: 10px;
  outline: none;

  color: var(--text);

  transition: 0.2s ease;
}

.form-group textarea {
  min-height: 110px;
  resize: vertical;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  border-color: var(--secondary);
  box-shadow: 0 0 0 3px rgba(22,119,200,0.10);
  background: white;
}

.success-message {
  padding: 11px 14px;
  border-radius: 10px;

  background: #ecfdf3;
  border: 1px solid #bbf7d0;

  color: #15803d;

  font-size: 13px;
  font-weight: 700;

  margin-bottom: 15px;
}


/* =========================================================
   EMPTY / LOGIN
   ========================================================= */

.empty-state,
.login-required {
  background: white;
  border: 1px dashed #cbd5e1;
  border-radius: var(--radius);

  padding: 45px 25px;

  text-align: center;
  color: var(--text-light);
}

.empty-state h3,
.login-required h3 {
  color: var(--primary-dark);
  margin-bottom: 7px;
}


/* =========================================================
   TABLE
   ========================================================= */

.table-wrapper {
  width: 100%;
  overflow-x: auto;

  background: white;
  border: 1px solid var(--border);
  border-radius: var(--radius);

  box-shadow: var(--shadow-sm);
}

.results-table {
  width: 100%;
  border-collapse: collapse;
  min-width: 700px;
}

.results-table th {
  background: #f3f7fb;
  color: var(--primary-dark);

  text-align: left;

  padding: 14px 16px;

  font-size: 12px;
  font-weight: 850;

  border-bottom: 1px solid var(--border);
}

.results-table td {
  padding: 14px 16px;

  color: #475569;
  font-size: 13px;

  border-bottom: 1px solid #edf1f5;
}

.results-table tr:last-child td {
  border-bottom: none;
}

.results-table tbody tr:hover {
  background: #f8fbff;
}

.grade-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 5px 10px;
  border-radius: 20px;

  background: #eaf4ff;
  color: var(--primary);

  font-size: 11px;
  font-weight: 900;
}


/* =========================================================
   PROFILE
   ========================================================= */

.profile-grid {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 20px;
}

.profile-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: var(--radius);

  padding: 28px;

  box-shadow: var(--shadow-sm);
}

.profile-card:first-child {
  text-align: center;
}

.profile-avatar {
  width: 110px;
  height: 110px;

  margin: 0 auto 15px;

  border-radius: 50%;

  background:
    linear-gradient(
      135deg,
      var(--primary),
      var(--secondary)
    );

  color: white;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 34px;
  font-weight: 900;

  border: 5px solid white;

  box-shadow: 0 10px 25px rgba(15,76,129,0.18);
}

.profile-card h2 {
  color: var(--primary-dark);
  font-size: 21px;
}

.profile-card > p {
  color: var(--text-light);
  font-size: 13px;
}

.profile-status {
  display: inline-block;

  margin-top: 12px;

  padding: 6px 12px;

  border-radius: 20px;

  background: #ecfdf3;
  color: #15803d;

  font-size: 11px;
  font-weight: 900;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 13px;
}

.info-grid > div {
  padding: 15px;

  background: #f8fafc;

  border: 1px solid #e7edf3;

  border-radius: 12px;
}

.info-grid span {
  display: block;

  color: var(--text-light);

  font-size: 11px;
  font-weight: 700;

  margin-bottom: 4px;
}

.info-grid strong {
  color: var(--primary-dark);
  font-size: 14px;
}


/* =========================================================
   FOOTER
   ========================================================= */

.footer {
  margin-top: 55px;

  background: #082d4f;
  color: white;
}

.footer-inner {
  max-width: 1400px;
  margin: auto;

  padding: 35px 30px;

  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 30px;
}

.footer h3 {
  font-size: 18px;
  margin-bottom: 7px;
}

.footer p {
  color: rgba(255,255,255,0.70);
  font-size: 12px;
}

.footer-links {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
}

.footer-links a {
  color: rgba(255,255,255,0.78);
  font-size: 12px;
}

.footer-links a:hover {
  color: white;
}

.footer-bottom {
  border-top: 1px solid rgba(255,255,255,0.10);

  max-width: 1400px;
  margin: auto;

  padding: 15px 30px;

  color: rgba(255,255,255,0.55);

  font-size: 11px;
}


/* =========================================================
   GENERAL TEXT
   ========================================================= */

.text-muted {
  color: var(--text-light);
}

.text-success {
  color: var(--success);
}

.text-danger {
  color: var(--danger);
}

.text-warning {
  color: var(--warning);
}


/* =========================================================
   RESPONSIVE - TABLET
   ========================================================= */

@media (max-width: 1100px) {

  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .quick-info-grid,
  .announcement-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .assignment-layout {
    grid-template-columns: 1fr;
  }

  .principal-section {
    grid-template-columns: 220px 1fr;
  }

}


/* =========================================================
   RESPONSIVE - MOBILE
   ========================================================= */

@media (max-width: 760px) {

  .header-inner {
    padding: 12px 16px;
    min-height: 70px;
  }

  .school-brand h1 {
    font-size: 16px;
  }

  .school-brand p {
    display: none;
  }

  .school-logo {
    width: 45px;
    height: 45px;
  }

  .header-actions {
    gap: 6px;
  }

  .login-button,
  .admin-button,
  .logout-button {
    padding: 9px 11px;
    font-size: 11px;
  }

  .nav-inner {
    padding: 0 12px;
  }

  .nav-link {
    padding: 12px 11px;
    font-size: 11px;
  }

  .main-content {
    padding: 18px 15px 35px;
  }

  .school-hero {
    min-height: 390px;
    border-radius: 18px;
  }

  .school-hero-content {
    min-height: 390px;
    padding: 40px 25px;
  }

  .school-hero h1 {
    font-size: 34px;
  }

  .school-hero p {
    font-size: 14px;
  }

  .stats-grid {
    grid-template-columns: 1fr 1fr;
    gap: 11px;
  }

  .stat-card {
    padding: 15px;
  }

  .stat-icon {
    width: 43px;
    height: 43px;
    font-size: 18px;
  }

  .stat-card h3 {
    font-size: 22px;
  }

  .quick-info-grid,
  .announcement-grid {
    grid-template-columns: 1fr;
  }

  .principal-section {
    grid-template-columns: 1fr;
    text-align: center;
    padding: 25px 18px;
  }

  .principal-image {
    width: 180px;
    height: 180px;
  }

  .principal-sign h2 {
    font-size: 23px;
  }

  .profile-grid {
    grid-template-columns: 1fr;
  }

  .form-row {
    grid-template-columns: 1fr;
  }

  .info-grid {
    grid-template-columns: 1fr;
  }

  .footer-inner {
    flex-direction: column;
    padding: 30px 20px;
  }

}


/* =========================================================
   SMALL MOBILE
   ========================================================= */

@media (max-width: 450px) {

  .student-header span {
    display: none;
  }

  .stats-grid {
    grid-template-columns: 1fr;
  }

  .school-hero h1 {
    font-size: 29px;
  }

  .hero-buttons {
    flex-direction: column;
  }

  .hero-main-button,
  .hero-outline-button {
    width: 100%;
  }

  .page-title {
    font-size: 25px;
  }

  .content-card,
  .assignment-form,
  .profile-card {
    padding: 18px;
  }

}


/* =========================================================
   SCROLLBAR
   ========================================================= */

::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: #eef2f7;
}

::-webkit-scrollbar-thumb {
  background: #a9bfd4;
  border-radius: 20px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--primary);
}


/* =========================================================
   SELECTION
   ========================================================= */

::selection {
  background: #cfe7fb;
  color: var(--primary-dark);
}
