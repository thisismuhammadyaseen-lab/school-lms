                </div>

              </form>
            )}

            {/* SEARCH */}

            <div className="search-box">

              🔎

              <input
                placeholder="Search attendance..."
                value={
                  searchAttendance
                }
                onChange={(e) =>
                  setSearchAttendance(
                    e.target.value
                  )
                }
              />

            </div>

            {/* TABLE */}

            <div className="table-card">

              <table>

                <thead>

                  <tr>
                    <th>ID</th>
                    <th>Student</th>
                    <th>Class</th>
                    <th>Roll</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>

                </thead>

                <tbody>

                  {filteredAttendance.map(
                    (item) => (
                      <tr key={item.id}>

                        <td>
                          {item.id}
                        </td>

                        <td>
                          <strong>
                            {item.student_name ||
                              "Unknown"}
                          </strong>
                        </td>

                        <td>
                          {item.class_name}
                        </td>

                        <td>
                          {item.roll_number}
                        </td>

                        <td>
                          {item.attendance_date
                            ? String(
                                item.attendance_date
                              ).split("T")[0]
                            : ""}
                        </td>

                        <td>

                          <span
                            className={
                              item.status ===
                              "Present"
                                ? "status-present"
                                : item.status ===
                                  "Absent"
                                ? "status-absent"
                                : "status-late"
                            }
                          >
                            {item.status ===
                              "Present" &&
                              "✅ "}
                            {item.status ===
                              "Absent" &&
                              "❌ "}
                            {item.status ===
                              "Late" &&
                              "⏰ "}

                            {item.status}
                          </span>

                        </td>

                        <td>

                          <button
                            className="edit-button"
                            onClick={() =>
                              openEditAttendance(
                                item
                              )
                            }
                          >
                            ✏️
                          </button>

                          <button
                            className="delete-button"
                            onClick={() =>
                              deleteAttendance(
                                item.id
                              )
                            }
                          >
                            🗑️
                          </button>

                        </td>

                      </tr>
                    )
                  )}

                </tbody>

              </table>

            </div>

          </section>
        )}

        {/* =================================================
            ANNOUNCEMENTS
        ================================================= */}

        {activeTab === "Announcements" && (
          <section className="management-section">

            <div className="management-title">

              <div>
                <h2>
                  📢 Announcements
                </h2>

                <p>
                  Manage school announcements.
                </p>
              </div>

              <button
                className="add-student-button"
                onClick={
                  openAddAnnouncement
                }
              >
                ➕ New Announcement
              </button>

            </div>

            {showAnnouncementForm && (
              <form
                className="student-form-card"
                onSubmit={
                  saveAnnouncement
                }
              >

                <h3>
                  {editingAnnouncement
                    ? "✏️ Edit Announcement"
                    : "📢 New Announcement"}
                </h3>

                <input
                  placeholder="Announcement Title"
                  value={
                    announcementForm.title
                  }
                  onChange={(e) =>
                    setAnnouncementForm({
                      ...announcementForm,
                      title:
                        e.target.value,
                    })
                  }
                  required
                />

                <textarea
                  placeholder="Announcement Message"
                  value={
                    announcementForm.message
                  }
                  onChange={(e) =>
                    setAnnouncementForm({
                      ...announcementForm,
                      message:
                        e.target.value,
                    })
                  }
                  required
                />

                <div className="form-buttons">

                  <button
                    type="submit"
                    className="save-student-button"
                  >
                    💾{" "}
                    {editingAnnouncement
                      ? "Update Announcement"
                      : "Save Announcement"}
                  </button>

                  <button
                    type="button"
                    className="cancel-button"
                    onClick={() =>
                      setShowAnnouncementForm(
                        false
                      )
                    }
                  >
                    Cancel
                  </button>

                </div>

              </form>
            )}

            <div className="search-box">

              🔎

              <input
                placeholder="Search announcements..."
                value={
                  searchAnnouncement
                }
                onChange={(e) =>
                  setSearchAnnouncement(
                    e.target.value
                  )
                }
              />

            </div>

            <div className="announcement-grid">

              {filteredAnnouncements.map(
                (item) => (
                  <div
                    className="announcement-card"
                    key={item.id}
                  >

                    <div className="announcement-icon">
                      📢
                    </div>

                    <div>

                      <h3>
                        {item.title}
                      </h3>

                      <p>
                        {item.message}
                      </p>

                      <div className="announcement-actions">

                        <button
                          className="edit-button"
                          onClick={() =>
                            openEditAnnouncement(
                              item
                            )
                          }
                        >
                          ✏️ Edit
                        </button>

                        <button
                          className="delete-button"
                          onClick={() =>
                            deleteAnnouncement(
                              item.id
                            )
                          }
                        >
                          🗑️ Delete
                        </button>

                      </div>

                    </div>

                  </div>
                )
              )}

            </div>

          </section>
        )}

      </main>

    </div>
  );
}

export default Admin;
