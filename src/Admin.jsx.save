mysql -u root -p -e "USE school_lms; DESCRIBE results;"import "./Admin.css";

const API = "http://localhost:5000";

function Admin({ onLogout }) {
  const [activeTab, setActiveTab] = useState("Dashboard");
  const [message, setMessage] = useState("");

  // =========================
  // DATA
  // =========================

  const [students, setStudents] = useState([]);
  const [teachers, setTeachers] = useState([]);
  const [assignments, setAssignments] = useState([]);
  const [results, setResults] = useState([]);
  const [attendance, setAttendance] = useState([]);
  const [announcements, setAnnouncements] = useState([]);

  // =========================
  // SEARCH
  // =========================

  const [searchStudent, setSearchStudent] = useState("");
  const [searchTeacher, setSearchTeacher] = useState("");
  const [searchAssignment, setSearchAssignment] = useState("");
  const [searchResult, setSearchResult] = useState("");
  const [searchAttendance, setSearchAttendance] = useState("");
  const [searchAnnouncement, setSearchAnnouncement] =
    useState("");

  // =========================
  // STUDENT
  // =========================

  const [showStudentForm, setShowStudentForm] =
    useState(false);

  const [editingStudent, setEditingStudent] =
    useState(null);

  const [studentForm, setStudentForm] = useState({
    name: "",
    father_name: "",
    class_name: "",
    roll_number: "",
    student_code: "",
    phone: "",
  });

  // =========================
  // TEACHER
  // =========================

  const [showTeacherForm, setShowTeacherForm] =
    useState(false);

  const [editingTeacher, setEditingTeacher] =
    useState(null);

  const [teacherForm, setTeacherForm] = useState({
    name: "",
    subject: "",
    phone: "",
  });

  // =========================
  // ASSIGNMENT
  // =========================

  const [showAssignmentForm, setShowAssignmentForm] =
    useState(false);

  const [assignmentForm, setAssignmentForm] = useState({
    title: "",
    subject: "",
    description: "",
    due_date: "",
    student_id: "",
  });

  const [assignmentFile, setAssignmentFile] =
    useState(null);

  // =========================
  // RESULT
  // =========================

  const [showResultForm, setShowResultForm] =
    useState(false);

  const [editingResult, setEditingResult] =
    useState(null);

  const [resultForm, setResultForm] = useState({
    student_id: "",
    subject: "",
    marks: "",
    total_marks: "100",
    grade: "",
  });

  // =========================
  // ATTENDANCE
  // =========================

  const [showAttendanceForm, setShowAttendanceForm] =
    useState(false);

  const [editingAttendance, setEditingAttendance] =
    useState(null);

  const [attendanceForm, setAttendanceForm] = useState({
    student_id: "",
    attendance_date: "",
    status: "Present",
  });

  // =========================
  // ANNOUNCEMENT
  // =========================

  const [showAnnouncementForm, setShowAnnouncementForm] =
    useState(false);

  const [editingAnnouncement, setEditingAnnouncement] =
    useState(null);

  const [announcementForm, setAnnouncementForm] = useState({
    title: "",
    message: "",
  });

  // =====================================================
  // LOAD ALL DATA
  // =====================================================

  const loadStudents = async () => {
    try {
      const response = await fetch(`${API}/students`);
      const data = await response.json();

      setStudents(Array.isArray(data) ? data : []);
    } catch (error) {
      console.error("Students error:", error);
      setStudents([]);
    }
  };

  const loadTeachers = async () => {
    try {
      const response = await fetch(`${API}/teachers`);
      const data = await response.json();

      setTeachers(Array.isArray(data) ? data : []);
    } catch (error) {
      console.error("Teachers error:", error);
      setTeachers([]);
    }
  };

  const loadAssignments = async () => {
    try {
      const response = await fetch(`${API}/assignments`);
      const data = await response.json();

      setAssignments(Array.isArray(data) ? data : []);
    } catch (error) {
      console.error("Assignments error:", error);
      setAssignments([]);
    }
  };

  const loadResults = async () => {
    try {
      const response = await fetch(`${API}/results`);
      const data = await response.json();

      setResults(Array.isArray(data) ? data : []);
    } catch (error) {
      console.error("Results error:", error);
      setResults([]);
    }
  };

  const loadAttendance = async () => {
    try {
      const response = await fetch(`${API}/attendance`);
      const data = await response.json();

      setAttendance(Array.isArray(data) ? data : []);
    } catch (error) {
      console.error("Attendance error:", error);
      setAttendance([]);
    }
  };

  const loadAnnouncements = async () => {
    try {
      const response = await fetch(`${API}/announcements`);
      const data = await response.json();

      setAnnouncements(
        Array.isArray(data) ? data : []
      );
    } catch (error) {
      console.error("Announcements error:", error);
      setAnnouncements([]);
    }
  };

  useEffect(() => {
    loadStudents();
    loadTeachers();
    loadAssignments();
    loadResults();
    loadAttendance();
    loadAnnouncements();
  }, []);

  // =====================================================
  // MESSAGE
  // =====================================================

  const showMessage = (text) => {
    setMessage(text);

    setTimeout(() => {
      setMessage("");
    }, 3000);
  };

  // =====================================================
  // STUDENT FUNCTIONS
  // =====================================================

  const openAddStudent = () => {
    setEditingStudent(null);

    setStudentForm({
      name: "",
      father_name: "",
      class_name: "",
      roll_number: "",
      student_code: "",
      phone: "",
    });

    setShowStudentForm(true);
  };

  const openEditStudent = (student) => {
    setEditingStudent(student);

    setStudentForm({
      name: student.name || "",
      father_name: student.father_name || "",
      class_name: student.class_name || "",
      roll_number: student.roll_number || "",
      student_code: student.student_code || "",
      phone: student.phone || "",
    });

    setShowStudentForm(true);
  };

  const saveStudent = async (e) => {
    e.preventDefault();

    try {
      const url = editingStudent
        ? `${API}/students/${editingStudent.id}`
        : `${API}/students`;

      const method = editingStudent ? "PUT" : "POST";

      const response = await fetch(url, {
        method,
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(studentForm),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          data.message || "Student save failed."
        );
      }

      showMessage(
        editingStudent
          ? "Student updated successfully."
          : "Student added successfully."
      );

      setShowStudentForm(false);
      setEditingStudent(null);

      loadStudents();
    } catch (error) {
      showMessage(error.message);
    }
  };

  const deleteStudent = async (id) => {
    if (!window.confirm("Delete this student?")) return;

    try {
      const response = await fetch(
        `${API}/students/${id}`,
        {
          method: "DELETE",
        }
      );

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          data.message || "Delete failed."
        );
      }

      showMessage("Student deleted successfully.");

      loadStudents();
    } catch (error) {
      showMessage(error.message);
    }
  };

  // =====================================================
  // TEACHER FUNCTIONS
  // =====================================================

  const openAddTeacher = () => {
    setEditingTeacher(null);

    setTeacherForm({
      name: "",
      subject: "",
      phone: "",
    });

    setShowTeacherForm(true);
  };

  const openEditTeacher = (teacher) => {
    setEditingTeacher(teacher);

    setTeacherForm({
      name: teacher.name || "",
      subject: teacher.subject || "",
      phone: teacher.phone || "",
    });

    setShowTeacherForm(true);
  };

  const saveTeacher = async (e) => {
    e.preventDefault();

    try {
      const url = editingTeacher
        ? `${API}/teachers/${editingTeacher.id}`
        : `${API}/teachers`;

      const method = editingTeacher ? "PUT" : "POST";

      const response = await fetch(url, {
        method,
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(teacherForm),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          data.message || "Teacher save failed."
        );
      }

      showMessage(
        editingTeacher
          ? "Teacher updated successfully."
          : "Teacher added successfully."
      );

      setShowTeacherForm(false);
      setEditingTeacher(null);

      loadTeachers();
    } catch (error) {
      showMessage(error.message);
    }
  };

  const deleteTeacher = async (id) => {
    if (!window.confirm("Delete this teacher?")) return;

    try {
      const response = await fetch(
        `${API}/teachers/${id}`,
        {
          method: "DELETE",
        }
      );

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          data.message || "Delete failed."
        );
      }

      showMessage("Teacher deleted successfully.");

      loadTeachers();
    } catch (error) {
      showMessage(error.message);
    }
  };

  // =====================================================
  // ASSIGNMENT FUNCTIONS
  // =====================================================

  const openAddAssignment = () => {
    setAssignmentForm({
      title: "",
      subject: "",
      description: "",
      due_date: "",
      student_id: "",
    });

    setAssignmentFile(null);

    setShowAssignmentForm(true);
  };

  const saveAssignment = async (e) => {
    e.preventDefault();

    try {
      let uploadedFile = "";

      if (assignmentFile) {
        const formData = new FormData();

        formData.append(
          "file",
          assignmentFile
        );

        const uploadResponse = await fetch(
          `${API}/upload`,
          {
            method: "POST",
            body: formData,
          }
        );

        const uploadData =
          await uploadResponse.json();

        if (!uploadResponse.ok) {
          throw new Error(
            uploadData.message ||
              "File upload failed."
          );
        }

        uploadedFile =
          uploadData.filename ||
          uploadData.file ||
          "";
      }

      const response = await fetch(
        `${API}/admin/assignments`,
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            ...assignmentForm,
            student_id: assignmentForm.student_id
              ? Number(
                  assignmentForm.student_id
                )
              : null,
            file: uploadedFile,
          }),
        }
      );

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          data.message ||
            "Assignment save failed."
        );
      }

      showMessage(
        "Assignment added successfully."
      );

      setShowAssignmentForm(false);

      loadAssignments();
    } catch (error) {
      showMessage(error.message);
    }
  };

  const deleteAssignment = async (id) => {
    if (
      !window.confirm(
        "Delete this assignment?"
      )
    )
      return;

    try {
      const response = await fetch(
        `${API}/assignments/${id}`,
        {
          method: "DELETE",
        }
      );

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          data.message ||
            "Assignment delete failed."
        );
      }

      showMessage(
        "Assignment deleted successfully."
      );

      loadAssignments();
    } catch (error) {
      showMessage(error.message);
    }
  };

  // =====================================================
  // RESULT FUNCTIONS
  // =====================================================

  const openAddResult = () => {
    setEditingResult(null);

    setResultForm({
      student_id: "",
      subject: "",
      marks: "",
      total_marks: "100",
      grade: "",
    });

    setShowResultForm(true);
  };

  const openEditResult = (result) => {
    setEditingResult(result);

    setResultForm({
      student_id: String(
        result.student_id || ""
      ),
      subject: result.subject || "",
      marks: result.marks || "",
      total_marks:
        result.total_marks || "100",
      grade: result.grade || "",
    });

    setShowResultForm(true);
  };

  const saveResult = async (e) => {
    e.preventDefault();

    try {
      const url = editingResult
        ? `${API}/results/${editingResult.id}`
        : `${API}/results`;

      const method = editingResult
        ? "PUT"
        : "POST";

      const response = await fetch(url, {
        method,
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          ...resultForm,
          student_id: Number(
            resultForm.student_id
          ),
          marks: Number(resultForm.marks),
          total_marks: Number(
            resultForm.total_marks
          ),
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          data.message ||
            "Result save failed."
        );
      }

      showMessage(
        editingResult
          ? "Result updated successfully."
          : "Result added successfully."
      );

      setShowResultForm(false);
      setEditingResult(null);

      loadResults();
    } catch (error) {
      showMessage(error.message);
    }
  };

  const deleteResult = async (id) => {
    if (!window.confirm("Delete this result?"))
      return;

    try {
      const response = await fetch(
        `${API}/results/${id}`,
        {
          method: "DELETE",
        }
      );

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          data.message ||
            "Result delete failed."
        );
      }

      showMessage(
        "Result deleted successfully."
      );

      loadResults();
    } catch (error) {
      showMessage(error.message);
    }
  };

  // =====================================================
  // ATTENDANCE FUNCTIONS
  // =====================================================

  const openAddAttendance = () => {
    setEditingAttendance(null);

    setAttendanceForm({
      student_id: "",
      attendance_date: new Date()
        .toISOString()
        .split("T")[0],
      status: "Present",
    });

    setShowAttendanceForm(true);
  };

  const openEditAttendance = (item) => {
    setEditingAttendance(item);

    let date = item.attendance_date || "";

    if (date.includes("T")) {
      date = date.split("T")[0];
    }

    setAttendanceForm({
      student_id: String(
        item.student_id || ""
      ),
      attendance_date: date,
      status: item.status || "Present",
    });

    setShowAttendanceForm(true);
  };

  const saveAttendance = async (e) => {
    e.preventDefault();

    if (!attendanceForm.student_id) {
      showMessage("Please select a student.");
      return;
    }

    if (!attendanceForm.attendance_date) {
      showMessage("Please select a date.");
      return;
    }

    try {
      const url = editingAttendance
        ? `${API}/attendance/${editingAttendance.id}`
        : `${API}/attendance`;

      const method = editingAttendance
        ? "PUT"
        : "POST";

      const response = await fetch(url, {
        method,
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          student_id: Number(
            attendanceForm.student_id
          ),
          attendance_date:
            attendanceForm.attendance_date,
          status:
            attendanceForm.status,
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          data.message ||
            "Attendance save failed."
        );
      }

      showMessage(
        editingAttendance
          ? "Attendance updated successfully."
          : "Attendance added successfully."
      );

      setShowAttendanceForm(false);
      setEditingAttendance(null);

      loadAttendance();
    } catch (error) {
      showMessage(error.message);
    }
  };

  const deleteAttendance = async (id) => {
    if (
      !window.confirm(
        "Delete this attendance record?"
      )
    )
      return;

    try {
      const response = await fetch(
        `${API}/attendance/${id}`,
        {
          method: "DELETE",
        }
      );

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          data.message ||
            "Attendance delete failed."
        );
      }

      showMessage(
        "Attendance deleted successfully."
      );

      loadAttendance();
    } catch (error) {
      showMessage(error.message);
    }
  };

  // =====================================================
  // ANNOUNCEMENT FUNCTIONS
  // =====================================================

  const openAddAnnouncement = () => {
    setEditingAnnouncement(null);

    setAnnouncementForm({
      title: "",
      message: "",
    });

    setShowAnnouncementForm(true);
  };

  const openEditAnnouncement = (
    announcement
  ) => {
    setEditingAnnouncement(
      announcement
    );

    setAnnouncementForm({
      title: announcement.title || "",
      message:
        announcement.message || "",
    });

    setShowAnnouncementForm(true);
  };

  const saveAnnouncement = async (e) => {
    e.preventDefault();

    try {
      const url = editingAnnouncement
        ? `${API}/announcements/${editingAnnouncement.id}`
        : `${API}/announcements`;

      const method = editingAnnouncement
        ? "PUT"
        : "POST";

      const response = await fetch(url, {
        method,
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(
          announcementForm
        ),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          data.message ||
            "Announcement save failed."
        );
      }

      showMessage(
        editingAnnouncement
          ? "Announcement updated successfully."
          : "Announcement added successfully."
      );

      setShowAnnouncementForm(false);
      setEditingAnnouncement(null);

      loadAnnouncements();
    } catch (error) {
      showMessage(error.message);
    }
  };

  const deleteAnnouncement = async (id) => {
    if (
      !window.confirm(
        "Delete this announcement?"
      )
    )
      return;

    try {
      const response = await fetch(
        `${API}/announcements/${id}`,
        {
          method: "DELETE",
        }
      );

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          data.message ||
            "Announcement delete failed."
        );
      }

      showMessage(
        "Announcement deleted successfully."
      );

      loadAnnouncements();
    } catch (error) {
      showMessage(error.message);
    }
  };

  // =====================================================
  // FILTERS
  // =====================================================

  const filteredStudents = useMemo(() => {
    const q = searchStudent.toLowerCase();

    return students.filter((student) =>
      [
        student.name,
        student.father_name,
        student.class_name,
        student.roll_number,
        student.student_code,
        student.phone,
      ]
        .join(" ")
        .toLowerCase()
        .includes(q)
    );
  }, [students, searchStudent]);

  const filteredTeachers = useMemo(() => {
    const q = searchTeacher.toLowerCase();

    return teachers.filter((teacher) =>
      [
        teacher.name,
        teacher.subject,
        teacher.phone,
      ]
        .join(" ")
        .toLowerCase()
        .includes(q)
    );
  }, [teachers, searchTeacher]);

  const filteredAssignments = useMemo(() => {
    const q = searchAssignment.toLowerCase();

    return assignments.filter((item) =>
      [
        item.title,
        item.subject,
        item.description,
        item.student_name,
      ]
        .join(" ")
        .toLowerCase()
        .includes(q)
    );
  }, [assignments, searchAssignment]);

  const filteredResults = useMemo(() => {
    const q = searchResult.toLowerCase();

    return results.filter((item) =>
      [
        item.student_name,
        item.subject,
        item.grade,
        item.marks,
      ]
        .join(" ")
        .toLowerCase()
        .includes(q)
    );
  }, [results, searchResult]);

  const filteredAttendance = useMemo(() => {
    const q = searchAttendance.toLowerCase();

    return attendance.filter((item) =>
      [
        item.student_name,
        item.class_name,
        item.roll_number,
        item.student_code,
        item.status,
        item.attendance_date,
      ]
        .join(" ")
        .toLowerCase()
        .includes(q)
    );
  }, [attendance, searchAttendance]);

  const filteredAnnouncements = useMemo(() => {
    const q =
      searchAnnouncement.toLowerCase();

    return announcements.filter((item) =>
      [
        item.title,
        item.message,
      ]
        .join(" ")
        .toLowerCase()
        .includes(q)
    );
  }, [
    announcements,
    searchAnnouncement,
  ]);

  // =====================================================
  // ATTENDANCE STATS
  // =====================================================

  const presentCount = attendance.filter(
    (a) => a.status === "Present"
  ).length;

  const absentCount = attendance.filter(
    (a) => a.status === "Absent"
  ).length;

  const lateCount = attendance.filter(
    (a) => a.status === "Late"
  ).length;

  // =====================================================
  // NAVIGATION
  // =====================================================

  const goTo = (tab) => {
    setActiveTab(tab);
    setMessage("");
  };

  // =====================================================
  // UI
  // =====================================================

  return (
    <div className="admin-container">

      {/* SIDEBAR */}
      <aside className="admin-sidebar">

        <div className="admin-logo">
          <div className="logo-icon">
            🎓
          </div>

          <div>
            <h2>Iqra Model</h2>
            <p>School LMS</p>
          </div>
        </div>

        <nav className="admin-nav">

          {[
            "Dashboard",
            "Students",
            "Teachers",
            "Assignments",
            "Results",
            "Attendance",
            "Announcements",
          ].map((tab) => (
            <button
              key={tab}
              className={
                activeTab === tab
                  ? "active"
                  : ""
              }
              onClick={() => goTo(tab)}
            >
              {tab === "Dashboard" && "📊"}
              {tab === "Students" && "👨‍🎓"}
              {tab === "Teachers" && "👨‍🏫"}
              {tab === "Assignments" && "📚"}
              {tab === "Results" && "📈"}
              {tab === "Attendance" && "📅"}
              {tab === "Announcements" && "📢"}

              <span>{tab}</span>
            </button>
          ))}

        </nav>

        <button
          className="admin-logout"
          onClick={onLogout}
        >
          🚪 Logout
        </button>

      </aside>

      {/* MAIN */}
      <main className="admin-main">

        {/* HEADER */}
        <header className="admin-header">

          <div>
            <h1>
              Iqra Model High School
            </h1>

            <p>
              School Management Administration
            </p>
          </div>

          <div className="admin-profile">
            <div className="online-dot"></div>

            <div>
              <strong>
                Administrator
              </strong>

              <small>
                Online
              </small>
            </div>
          </div>

        </header>

        {/* MESSAGE */}
        {message && (
          <div className="admin-message">
            {message}
          </div>
        )}

        {/* =================================================
            DASHBOARD
        ================================================= */}

        {activeTab === "Dashboard" && (
          <section>

            <div className="welcome-card">

              <div>
                <span>
                  👋 Welcome Back
                </span>

                <h2>
                  School Administrator
                </h2>

                <p>
                  Manage your complete school
                  system from one place.
                </p>
              </div>

              <div className="welcome-icon">
                🏫
              </div>

            </div>

            {/* STATS */}

            <div className="admin-stats">

              <div className="stat-card">
                <span>👨‍🎓</span>
                <div>
                  <small>
                    Students
                  </small>
                  <strong>
                    {students.length}
                  </strong>
                </div>
              </div>

              <div className="stat-card">
                <span>👨‍🏫</span>
                <div>
                  <small>
                    Teachers
                  </small>
